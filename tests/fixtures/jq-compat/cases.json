{
  "cases": [
    {
      "name": "identity-object",
      "args": ["."],
      "stdin": "{\"a\":1,\"b\":[1,2]}",
      "expect": ["{","  \"a\": 1,","  \"b\": [","    1,","    2","  ]","}"]
    },
    {
      "name": "identity-keeps-key-order",
      "args": ["."],
      "stdin": "{\"b\":1,\"a\":2}",
      "expect": ["{","  \"b\": 1,","  \"a\": 2","}"]
    },
    {
      "name": "compact-output",
      "args": ["-c","."],
      "stdin": "{\"b\":1,\"a\":[1,2]}",
      "expect": ["{\"b\":1,\"a\":[1,2]}"]
    },
    {
      "name": "raw-output-string",
      "args": ["-r",".name"],
      "stdin": "{\"name\":\"jqc\"}",
      "expect": ["jqc"]
    },
    {
      "name": "raw-output-non-string",
      "args": ["-r","."],
      "stdin": "{\"a\":1}",
      "expect": ["{","  \"a\": 1","}"]
    },
    {
      "name": "raw-compact-non-string",
      "args": ["-r","-c","."],
      "stdin": "{\"a\":1}",
      "expect": ["{\"a\":1}"]
    },
    {
      "name": "monochrome-output",
      "args": ["-M","."],
      "stdin": "{\"a\":1}",
      "expect": ["{","  \"a\": 1","}"]
    },
    {
      "name": "null-input-object",
      "args": ["-n","-c","{a: 1, b: [2]}"],
      "expect": ["{\"a\":1,\"b\":[2]}"]
    },
    {
      "name": "null-input-range",
      "args": ["-n","-c","[range(3)]"],
      "expect": ["[0,1,2]"]
    },
    {
      "name": "multiple-outputs",
      "args": [".[]"],
      "stdin": "[1,\"two\",null]",
      "expect": ["1","\"two\"","null"]
    },
    {
      "name": "select-map",
      "args": ["-c","map(select(. > 1))"],
      "stdin": "[1,2,3]",
      "expect": ["[2,3]"]
    },
    {
      "name": "empty-containers",
      "args": ["."],
      "stdin": "{\"a\":[],\"b\":{}}",
      "expect": ["{","  \"a\": [],","  \"b\": {}","}"]
    },
    {
      "name": "nested-pretty",
      "args": ["."],
      "stdin": "{\"a\":{\"b\":[1,{\"c\":true}]}}",
      "expect": ["{","  \"a\": {","    \"b\": [","      1,","      {","        \"c\": true","      }","    ]","  }","}"]
    },
    {
      "name": "string-escapes",
      "args": ["."],
      "stdin": "{\"s\":\"q\\\" b\\\\ n\\n t\\t\"}",
      "expect": ["{","  \"s\": \"q\\\" b\\\\ n\\n t\\t\"","}"]
    },
    {
      "name": "unicode-raw-string",
      "args": ["-r",".s"],
      "stdin": "{\"s\":\"日本語\"}",
      "expect": ["日本語"]
    },
    {
      "name": "decimal-numbers",
      "args": ["-c","."],
      "stdin": "[1.5,-0.25,100]",
      "expect": ["[1.5,-0.25,100]"]
    },
    {
      "name": "whole-float-result",
      "args": ["-c",".a + 0.5"],
      "stdin": "{\"a\":0.5}",
      "expect": ["1"]
    },
    {
      "name": "exponent-sign",
      "args": ["-c",". * 1e20"],
      "stdin": "1",
      "expect": ["1e+20"]
    },
    {
      "name": "computed-numbers-pretty",
      "args": ["-n","[1e20*1, 0.5+0.5, 1e-5*1]"],
      "expect": ["[","  1e+20,","  1,","  1e-05","]"]
    },
    {
      "name": "number-literals",
      "args": ["-c","."],
      "stdin": "[1.000,1e2,-0.0,0.00001,-1e1000,1.5e300]",
      "expect": ["[1.000,1E+2,-0.0,0.00001,-1E+1000,1.5E+300]"]
    },
    {
      "name": "big-integer-arithmetic",
      "args": ["-c",". + 0"],
      "stdin": "100000000000000000001",
      "expect": ["1e+20"],
      "jqc": ["100000000000000000001"],
      "note": "jaq computes with integers of any size, where jq converts them to doubles first."
    },
    {
      "name": "negative-zero",
      "args": ["-c","."],
      "stdin": "-0",
      "expect": ["-0"],
      "jqc": ["0"],
      "note": "jaq reads -0 as the integer 0. Keeping it an integer lets it index arrays, as it does in jq."
    },
    {
      "name": "negative-zero-index",
      "args": ["-c",". as $i | [\"first\"][$i]"],
      "stdin": "-0",
      "expect": ["\"first\""]
    },
    {
      "name": "non-string-object-key",
      "args": ["-n","{(1): \"x\"}"],
      "expect": [],
      "status": 3,
      "jqc_status": 1,
      "note": "jq rejects the key when it compiles the filter. jaq builds the object, so jqc rejects it when it prints the result."
    },
    {
      "name": "computed-number-tie",
      "args": ["-n","-c","1000000000000000.25 * 1"],
      "expect": ["1000000000000000.2"]
    },
    {
      "name": "nan",
      "args": ["-n","-c","nan"],
      "expect": ["null"]
    },
    {
      "name": "nan-pretty",
      "args": ["-n","[nan]"],
      "expect": ["[","  null","]"]
    },
    {
      "name": "infinite",
      "args": ["-n","-c","[infinite,-infinite]"],
      "expect": ["[1.7976931348623157e+308,-1.7976931348623157e+308]"]
    },
    {
      "name": "assign-nan",
      "args": ["-c",".a = nan"],
      "stdin": "{\"a\":1}",
      "expect": ["{\"a\":null}"]
    },
    {
      "name": "big-integer",
      "args": ["."],
      "stdin": "100000000000000000001",
      "expect": ["100000000000000000001"]
    },
    {
      "name": "big-integer-equality",
      "args": [". == 100000000000000000000"],
      "stdin": "100000000000000000001",
      "expect": ["false"]
    },
    {
      "name": "huge-number",
      "args": ["."],
      "stdin": "1e1000",
      "expect": ["1E+1000"]
    },
    {
      "name": "runtime-error-status",
      "args": [".a"],
      "stdin": "1",
      "expect": [],
      "status": 5,
      "jqc_status": 1,
      "note": "Bug #44: exits with status 1 instead of 5 on runtime errors and invalid input"
    },
    {
      "name": "invalid-input-status",
      "args": ["."],
      "stdin": "not json",
      "expect": [],
      "status": 5,
      "jqc_status": 1,
      "note": "Bug #44: exits with status 1 instead of 5 on runtime errors and invalid input"
    },
    {
      "name": "multiple-stdin-values",
      "args": ["-c","."],
      "stdin": "1 2",
      "expect": ["1","2"],
      "jqc": [],
      "jqc_status": 1,
      "note": "Bug #50: multiple JSON values on stdin fail to parse"
    },
    {
      "name": "multiple-files",
      "args": ["-c",".a","f1.json","f2.json"],
      "files": {"f1.json":"{\"a\":1}","f2.json":"{\"a\":2}"},
      "expect": ["1","2"],
      "jqc": [],
      "jqc_status": 2,
      "note": "Bug #51: only one input file is accepted"
    },
    {
      "name": "assign",
      "args": ["-c",".a = 5"],
      "stdin": "{\"a\":1,\"b\":2}",
      "expect": ["{\"a\":5,\"b\":2}"]
    },
    {
      "name": "update",
      "args": ["-c",".a |= . + 1"],
      "stdin": "{\"a\":1}",
      "expect": ["{\"a\":2}"]
    },
    {
      "name": "arithmetic-update",
      "args": ["-c",".a += 10"],
      "stdin": "{\"a\":1}",
      "expect": ["{\"a\":11}"]
    },
    {
      "name": "alternative-update",
      "args": ["-c",".a //= 3"],
      "stdin": "{\"a\":null,\"b\":1}",
      "expect": ["{\"a\":3,\"b\":1}"]
    },
    {
      "name": "edit-keeps-number-spelling",
      "args": ["-c",".b = 1"],
      "stdin": "{\"a\":1e2,\"b\":0}",
      "expect": ["{\"a\":1E+2,\"b\":1}"],
      "jqc": ["{\"a\":1e2,\"b\":1}"],
      "note": "Edit mode keeps the source text of values it does not change, including how numbers are written."
    },
    {
      "name": "assign-new-key",
      "args": ["-c",".c = true"],
      "stdin": "{\"a\":1}",
      "expect": ["{\"a\":1,\"c\":true}"],
      "jqc": ["{","  \"a\":1,","  \"c\": true","}"],
      "note": "Bug #68: -c is ignored in edit mode"
    },
    {
      "name": "assign-object-keeps-key-order",
      "args": ["-c",".x = {\"b\":1,\"a\":2}"],
      "stdin": "{\"x\":0}",
      "expect": ["{\"x\":{\"b\":1,\"a\":2}}"],
      "jqc": ["{\"x\":{","    \"b\": 1,","    \"a\": 2","  }}"],
      "note": "Bug #68: -c is ignored in edit mode"
    },
    {
      "name": "assign-computed-numbers",
      "args": ["-c",".a = .a + 0.5 | .b *= 1e20"],
      "stdin": "{\"a\":0.5,\"b\":2}",
      "expect": ["{\"a\":1,\"b\":2e+20}"]
    },
    {
      "name": "assign-array-keeps-exact-numbers",
      "args": ["-c",".a = [9007199254740992.0, 2]"],
      "stdin": "{\"a\":[9007199254740993]}",
      "expect": ["{\"a\":[9007199254740992.0,2]}"],
      "jqc": ["{\"a\":[9007199254740992.0, 2]}"],
      "note": "Bug #68: -c is ignored in edit mode"
    },
    {
      "name": "assign-invalid-utf8",
      "args": ["-c",".a = (\"/w==\" | @base64d)"],
      "stdin": "{}",
      "expect": ["{\"a\":\"�\"}"],
      "jqc": ["{","  \"a\": \"�\"","}"],
      "note": "Bug #68: -c is ignored in edit mode"
    },
    {
      "name": "assign-array-element",
      "args": ["-c",".a[1] = 9"],
      "stdin": "{\"a\":[1,2,3]}",
      "expect": ["{\"a\":[1,9,3]}"]
    },
    {
      "name": "update-each",
      "args": ["-c",".[] |= . * 2"],
      "stdin": "{\"x\":1,\"y\":2}",
      "expect": ["{\"x\":2,\"y\":4}"]
    },
    {
      "name": "del-key",
      "args": ["-c","del(.a)"],
      "stdin": "{\"a\":1,\"b\":2}",
      "expect": ["{\"b\":2}"]
    },
    {
      "name": "del-array-element",
      "args": ["-c","del(.a[0])"],
      "stdin": "{\"a\":[1,2]}",
      "expect": ["{\"a\":[2]}"]
    },
    {
      "name": "del-select",
      "args": ["-c","del(.[] | select(. == 2))"],
      "stdin": "[1,2,3,2]",
      "expect": ["[1,3]"]
    },
    {
      "name": "duplicate-key-assign",
      "args": ["-c",".a = 9"],
      "stdin": "{\"a\":1,\"a\":2}",
      "expect": ["{\"a\":9}"],
      "jqc": ["{\"a\":1,\"a\":9}"],
      "note": "Edit mode keeps earlier duplicate keys in place (#37). jq reads only the last one, so both hold the same value."
    },
    {
      "name": "duplicate-key-del",
      "args": ["-c","del(.a)"],
      "stdin": "{\"a\":1,\"b\":0,\"a\":2}",
      "expect": ["{\"b\":0}"]
    },
    {
      "name": "big-integer-rewrite",
      "args": ["-c",".a |= ."],
      "stdin": "{\"a\":100000000000000000001}",
      "expect": ["{\"a\":100000000000000000001}"]
    },
    {
      "name": "assign-missing-parent",
      "args": ["-c",".a.b = 1"],
      "stdin": "{}",
      "expect": ["{\"a\":{\"b\":1}}"],
      "jqc": [],
      "jqc_status": 1,
      "note": "Bug #45: assigning under a missing or null parent errors instead of creating it"
    },
    {
      "name": "assign-past-end",
      "args": ["-c",".a[1] = 1"],
      "stdin": "{\"a\":[5]}",
      "expect": ["{\"a\":[5,1]}"],
      "jqc": [],
      "jqc_status": 1,
      "note": "Bug #46: assigning past the end of an array errors instead of extending it"
    },
    {
      "name": "assign-negative-index",
      "args": ["-c",".a[-1] = 0"],
      "stdin": "{\"a\":[1,2,3]}",
      "expect": ["{\"a\":[1,2,0]}"],
      "jqc": [],
      "jqc_status": 1,
      "note": "Bug #47: assignments to negative array indexes error"
    },
    {
      "name": "assign-slice",
      "args": ["-c",".a[1:] = []"],
      "stdin": "{\"a\":[1,2,3]}",
      "expect": ["{\"a\":[1]}"],
      "jqc": [],
      "jqc_status": 1,
      "note": "Bug #48: assignments to array slices error"
    },
    {
      "name": "del-multiple-paths",
      "args": ["-c","del(.a, .b)"],
      "stdin": "{\"a\":1,\"b\":2,\"c\":3}",
      "expect": ["{\"c\":3}"],
      "jqc": [],
      "jqc_status": 1,
      "note": "Bug #49: del() with multiple paths errors"
    },
    {
      "name": "assign-multiple-results",
      "args": ["-c",".a = (1,2)"],
      "stdin": "{\"a\":0}",
      "expect": ["{\"a\":1}","{\"a\":2}"],
      "jqc": [],
      "jqc_status": 1,
      "note": "Bug #66: edit expressions with multiple results error instead of printing each result"
    }
  ]
}
