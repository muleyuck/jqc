{
  "cases": [
    {
      "name": "identity-object",
      "args": ["."],
      "stdin": "{\"a\":1,\"b\":[1,2]}",
      "expect": ["{","  \"a\": 1,","  \"b\": [","    1,","    2","  ]","}"]
    },
    {
      "name": "identity-keeps-key-order",
      "args": ["."],
      "stdin": "{\"b\":1,\"a\":2}",
      "expect": ["{","  \"b\": 1,","  \"a\": 2","}"]
    },
    {
      "name": "compact-output",
      "args": ["-c","."],
      "stdin": "{\"b\":1,\"a\":[1,2]}",
      "expect": ["{\"b\":1,\"a\":[1,2]}"]
    },
    {
      "name": "raw-output-string",
      "args": ["-r",".name"],
      "stdin": "{\"name\":\"jqc\"}",
      "expect": ["jqc"]
    },
    {
      "name": "raw-output-non-string",
      "args": ["-r","."],
      "stdin": "{\"a\":1}",
      "expect": ["{","  \"a\": 1","}"]
    },
    {
      "name": "raw-compact-non-string",
      "args": ["-r","-c","."],
      "stdin": "{\"a\":1}",
      "expect": ["{\"a\":1}"]
    },
    {
      "name": "monochrome-output",
      "args": ["-M","."],
      "stdin": "{\"a\":1}",
      "expect": ["{","  \"a\": 1","}"]
    },
    {
      "name": "null-input-object",
      "args": ["-n","-c","{a: 1, b: [2]}"],
      "expect": ["{\"a\":1,\"b\":[2]}"]
    },
    {
      "name": "null-input-range",
      "args": ["-n","-c","[range(3)]"],
      "expect": ["[0,1,2]"]
    },
    {
      "name": "multiple-outputs",
      "args": [".[]"],
      "stdin": "[1,\"two\",null]",
      "expect": ["1","\"two\"","null"]
    },
    {
      "name": "select-map",
      "args": ["-c","map(select(. > 1))"],
      "stdin": "[1,2,3]",
      "expect": ["[2,3]"]
    },
    {
      "name": "empty-containers",
      "args": ["."],
      "stdin": "{\"a\":[],\"b\":{}}",
      "expect": ["{","  \"a\": [],","  \"b\": {}","}"]
    },
    {
      "name": "nested-pretty",
      "args": ["."],
      "stdin": "{\"a\":{\"b\":[1,{\"c\":true}]}}",
      "expect": ["{","  \"a\": {","    \"b\": [","      1,","      {","        \"c\": true","      }","    ]","  }","}"]
    },
    {
      "name": "string-escapes",
      "args": ["."],
      "stdin": "{\"s\":\"q\\\" b\\\\ n\\n t\\t\"}",
      "expect": ["{","  \"s\": \"q\\\" b\\\\ n\\n t\\t\"","}"]
    },
    {
      "name": "unicode-raw-string",
      "args": ["-r",".s"],
      "stdin": "{\"s\":\"日本語\"}",
      "expect": ["日本語"]
    },
    {
      "name": "decimal-numbers",
      "args": ["-c","."],
      "stdin": "[1.5,-0.25,100]",
      "expect": ["[1.5,-0.25,100]"]
    },
    {
      "name": "whole-float-result",
      "args": ["-c",".a + 0.5"],
      "stdin": "{\"a\":0.5}",
      "expect": ["1"]
    },
    {
      "name": "exponent-sign",
      "args": ["-c",". * 1e20"],
      "stdin": "1",
      "expect": ["1e+20"]
    },
    {
      "name": "computed-numbers-pretty",
      "args": ["-n","[1e20*1, 0.5+0.5, 1e-5*1]"],
      "expect": ["[","  1e+20,","  1,","  1e-05","]"]
    },
    {
      "name": "number-literals",
      "args": ["-c","."],
      "stdin": "[1.000,1e2,-0.0,0.00001,-1e1000,1.5e300]",
      "expect": ["[1.000,1E+2,-0.0,0.00001,-1E+1000,1.5E+300]"]
    },
    {
      "name": "big-integer-arithmetic",
      "args": ["-c",". + 0"],
      "stdin": "100000000000000000001",
      "expect": ["1e+20"]
    },
    {
      "name": "negative-zero",
      "args": ["-c","."],
      "stdin": "-0",
      "expect": ["-0"]
    },
    {
      "name": "negative-zero-index",
      "args": ["-c",". as $i | [\"first\"][$i]"],
      "stdin": "-0",
      "expect": ["\"first\""]
    },
    {
      "name": "non-string-object-key",
      "args": ["-n","{(1): \"x\"}"],
      "expect": [],
      "status": 3
    },
    {
      "name": "computed-number-tie",
      "args": ["-n","-c","1000000000000000.25 * 1"],
      "expect": ["1000000000000000.2"]
    },
    {
      "name": "tonumber-leading-zero",
      "args": ["-n","-c","\"01.5\" | tonumber"],
      "expect": ["1.5"]
    },
    {
      "name": "nan",
      "args": ["-n","-c","nan"],
      "expect": ["null"]
    },
    {
      "name": "nan-pretty",
      "args": ["-n","[nan]"],
      "expect": ["[","  null","]"]
    },
    {
      "name": "infinite",
      "args": ["-n","-c","[infinite,-infinite]"],
      "expect": ["[1.7976931348623157e+308,-1.7976931348623157e+308]"]
    },
    {
      "name": "big-integer",
      "args": ["."],
      "stdin": "100000000000000000001",
      "expect": ["100000000000000000001"]
    },
    {
      "name": "big-integer-equality",
      "args": [". == 100000000000000000000"],
      "stdin": "100000000000000000001",
      "expect": ["false"]
    },
    {
      "name": "duplicate-keys",
      "args": ["-c","."],
      "stdin": "{\"a\":1,\"a\":2}",
      "expect": ["{\"a\":2}"]
    },
    {
      "name": "huge-number",
      "args": ["."],
      "stdin": "1e1000",
      "expect": ["1E+1000"]
    },
    {
      "name": "runtime-error-status",
      "args": [".a"],
      "stdin": "1",
      "expect": [],
      "status": 5
    },
    {
      "name": "invalid-input-status",
      "args": ["."],
      "stdin": "not json",
      "expect": [],
      "status": 5
    },
    {
      "name": "multiple-stdin-values",
      "args": ["-c","."],
      "stdin": "1 2",
      "expect": ["1","2"]
    },
    {
      "name": "multiple-files",
      "args": ["-c",".a","f1.json","f2.json"],
      "files": {"f1.json":"{\"a\":1}","f2.json":"{\"a\":2}"},
      "expect": ["1","2"]
    },
    {
      "name": "input-filename",
      "args": ["-c","input_filename","f.json"],
      "files": {"f.json": "1"},
      "expect": ["\"f.json\""],
      "jqc": ["\"<stdin>\""],
      "note": "jqc converts the inputs and passes them to jq on stdin, so jq sees no file name."
    },
    {
      "name": "seq-input",
      "args": ["--seq","-c","."],
      "stdin": "\u001e1\n",
      "expect": ["\u001e1"]
    },
    {
      "name": "stream-duplicate-keys",
      "args": ["--stream","-c","."],
      "stdin": "{\"a\":1,\"a\":2}",
      "expect": ["[[\"a\"],1]","[[\"a\"],2]","[[\"a\"]]"],
      "jqc": ["[[\"a\"],2]","[[\"a\"]]"],
      "note": "jqc's conversion keeps only the last value of a duplicate key, so --stream sees one."
    },
    {
      "name": "halt-error-status-hides-unreadable-input",
      "args": [".|halt_error(3)","missing.json","good.json"],
      "files": {"good.json": "1"},
      "expect": [],
      "status": 2,
      "jqc_status": 3,
      "note": "jqc can't tell halt_error(2) or halt_error(3) from jq's usage and compile errors, which end jq before it reads input, so the unreadable file isn't reported."
    }
  ]
}
